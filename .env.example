AGENT_MODEL_BACKEND=stub
AGENT_SCENARIO=healthy
AGENT_DB_PATH=data/conversations.sqlite
AGENT_PORT=5000
AGENT_MODEL_TIMEOUT=6
AGENT_REWRITE_TIMEOUT=8
AGENT_COMPANY_NAME=Soporte
AGENT_BOT_NAME=
# Live modes need explicit endpoint and model. Secrets come only from environment.
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_KEY=
# Default: live model -> true; stub -> false. Optional explicit opt-out: false.
# AGENT_REWRITE=false
AGENT_SESSION_SECRET=
AGENT_WHATSAPP_SENDER=fake
AGENT_WHATSAPP_BASE_URL=
AGENT_WHATSAPP_ACCESS_TOKEN=
AGENT_WHATSAPP_VERIFY_TOKEN=
AGENT_WHATSAPP_APP_SECRET=
AGENT_CONFIDENCE_THRESHOLD=0.7
AGENT_LOCKOUT_SECONDS=900
AGENT_WEBHOOK_MAX_AGE=600

# Enable only for the local staff demo, never behind a public proxy.
AGENT_STAFF_PANEL=false
